<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="art.picotronnest.executionlab" android:versionCode="1" android:versionName="0.0.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application android:label="PicotronNest" android:debuggable="true"
        android:allowBackup="false" android:extractNativeLibs="true"
        android:supportsRtl="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".RuntimeSetupActivity" android:exported="false" />
        <activity android:name=".InputSettingsActivity" android:exported="false" />
        <activity android:name=".GamepadSettingsActivity" android:exported="false" />
        <activity android:name=".ProjectFilesActivity" android:exported="false" />
        <activity android:name=".AboutActivity" android:exported="false" />
        <service android:name=".RuntimeService" android:foregroundServiceType="mediaPlayback" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
