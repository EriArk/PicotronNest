<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="art.picotronnest" android:versionCode="1003" android:versionName="0.1.0-beta.3">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application android:label="PicotronNest" android:icon="@drawable/ic_launcher"
        android:debuggable="false" android:allowBackup="false" android:extractNativeLibs="true"
        android:supportsRtl="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name="art.picotronnest.executionlab.LauncherActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="art.picotronnest.executionlab.MainActivity" android:exported="false" />
        <activity android:name="art.picotronnest.executionlab.RuntimeSetupActivity" android:exported="false" />
        <activity android:name="art.picotronnest.executionlab.InputSettingsActivity" android:exported="false" />
        <activity android:name="art.picotronnest.executionlab.GamepadSettingsActivity" android:exported="false" />
        <activity android:name="art.picotronnest.executionlab.ProjectFilesActivity" android:exported="false" />
        <activity android:name="art.picotronnest.executionlab.AboutActivity" android:exported="false" />
        <service android:name="art.picotronnest.executionlab.RuntimeService" android:foregroundServiceType="mediaPlayback" android:exported="false" />
    </application>
</manifest>
